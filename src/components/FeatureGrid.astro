---
export interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = "核心交易产品",
  subtitle = "杜高斯贝银行提供以下主要交易产品，覆盖全球主要金融市场。点击了解详情。",
} = Astro.props;

const features = [
  {
    icon: "💱",
    title: "外汇交易",
    description: "超过50种货币对，包括主要、次要和 exotic 货币对。杠杆率高达1:200，点差从0.1点起。",
    link: "https://www.dukascopy.com/swiss/chinese/forex/trading/",
  },
  {
    icon: "📈",
    title: "差价合约 (CFD)",
    description: "交易全球股指、股票、大宗商品和债券CFD。杠杆限制灵活，满足不同交易策略需求。",
    link: "https://www.dukascopy.com/swiss/chinese/cfd/range-of-markets/",
  },
  {
    icon: "₿",
    title: "加密货币",
    description: "24/7杠杆加密货币交易，支持比特币、以太坊等主流数字货币。改进的价差和流动性。",
    link: "https://www.dukascopy.com/swiss/chinese/crypto/range-of-markets/",
  },
  {
    icon: "🥇",
    title: "贵金属 & 商品",
    description: "黄金、白银等贵金属现货交易，以及原油等大宗商品。瑞士银行的安全保障。",
    link: "https://www.dukascopy.com/swiss/chinese/forex/trading/#metals",
  },
  {
    icon: "🏛️",
    title: "多币种银行账户",
    description: "具有IBAN的24种货币的经常账户，附带实体卡和虚拟卡，支持全球资金管理。",
    link: "https://www.dukascopy.bank/swiss/open-mca-account/?lang=zh",
  },
  {
    icon: "🤖",
    title: "自动交易(JForex)",
    description: "在30分钟内创建你自己的交易策略。强大的JForex API支持算法交易和策略回测。",
    link: "https://www.dukascopy.com/swiss/chinese/forex/jforex/",
  },
];
---

<section id="trading" class="section">
  <div class="container">
    <h2 class="section-title">{title}</h2>
    <p class="section-subtitle">{subtitle}</p>
    <div class="grid grid-3">
      {features.map((feature) => (
        <a href={feature.link} class="card feature-card" target="_blank">
          <span class="feature-icon">{feature.icon}</span>
          <h3 class="feature-title">{feature.title}</h3>
          <p class="feature-desc">{feature.description}</p>
          <span class="feature-link">了解更多 →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .feature-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    cursor: pointer;
  }

  .feature-icon {
    font-size: 2.5rem;
    margin-bottom: 16px;
    display: block;
  }

  .feature-title {
    font-size: 1.25rem;
    margin-bottom: 12px;
    color: var(--gray-900);
  }

  .feature-desc {
    font-size: 0.9375rem;
    color: var(--gray-500);
    line-height: 1.7;
    flex: 1;
  }

  .feature-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--swiss-red);
    margin-top: 16px;
    transition: gap 0.2s ease;
  }

  .feature-card:hover .feature-link {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .feature-icon {
      font-size: 2rem;
      margin-bottom: 10px;
    }
    .feature-title {
      font-size: 1.125rem;
      margin-bottom: 8px;
    }
    .feature-desc {
      font-size: 0.875rem;
    }
  }
</style>
