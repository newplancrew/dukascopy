---
const { size = 'medium', light = false } = Astro.props;

const sizes = {
  small: { fontSize: '1.25rem', gap: '8px' },
  medium: { fontSize: '1.5rem', gap: '10px' },
  large: { fontSize: '2rem', gap: '12px' },
};

const s = sizes[size];
const cls = light ? 'logo logo-light' : 'logo';
---

<a
	href="/"
	class={cls}
	aria-label="全球交易导航首页"
	style={`--logo-gap:${s.gap};--logo-size:${s.fontSize};`}
>
	<svg
		class="logo-icon"
		width="28"
		height="28"
		viewBox="0 0 28 28"
		fill="none"
		xmlns="http://www.w3.org/2000/svg"
		aria-hidden="true"
	>
		<circle cx="14" cy="14" r="11" stroke="#DA291C" stroke-width="2" fill="none"/>
		<ellipse cx="14" cy="14" rx="6" ry="11" stroke="#DA291C" stroke-width="1.2" fill="none"/>
		<line x1="3" y1="14" x2="25" y2="14" stroke="#DA291C" stroke-width="1.2"/>
		<circle cx="14" cy="14" r="3" fill="#DA291C" opacity="0.15"/>
	</svg>
	<span class="logo-text">
		<span class="logo-name">全球交易导航</span>
	</span>
</a>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: var(--logo-gap);
		text-decoration: none;
		white-space: nowrap;
	}

	.logo-icon {
		flex-shrink: 0;
	}

	.logo-text {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: var(--logo-size);
		font-weight: 700;
	}

	.logo-name {
		color: var(--navy);
	}

	.logo-light .logo-name {
		color: var(--white);
	}
</style>
