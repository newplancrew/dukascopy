---
const { size = 'medium' } = Astro.props;

const sizes = {
  small: { fontSize: '1.25rem', gap: '8px' },
  medium: { fontSize: '1.5rem', gap: '10px' },
  large: { fontSize: '2rem', gap: '12px' },
};

const s = sizes[size];
---

<a
	href="/"
	class="logo"
	aria-label="杜高斯贝银行首页"
	style={`--logo-gap:${s.gap};--logo-size:${s.fontSize};`}
>
	<svg
		class="logo-icon"
		width="28"
		height="28"
		viewBox="0 0 28 28"
		fill="none"
		xmlns="http://www.w3.org/2000/svg"
		aria-hidden="true"
	>
		<rect width="28" height="28" rx="4" fill="#DA291C"></rect>
		<rect x="4" y="12" width="20" height="4" rx="2" fill="white"></rect>
		<rect x="12" y="4" width="4" height="20" rx="2" fill="white"></rect>
	</svg>
	<span class="logo-text">
		<span class="logo-name">杜高斯贝</span>
		<span class="logo-divider">|</span>
		<span class="logo-suffix">Dukascopy</span>
	</span>
</a>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: var(--logo-gap);
		text-decoration: none;
		white-space: nowrap;
	}

	.logo-icon {
		flex-shrink: 0;
	}

	.logo-text {
		display: inline-flex;
		align-items: baseline;
		gap: 6px;
		font-size: var(--logo-size);
		font-weight: 700;
	}

	.logo-name {
		color: var(--gray-900);
	}

	.logo-divider {
		color: var(--swiss-red);
		font-weight: 300;
	}

	.logo-suffix {
		color: var(--gray-500);
		font-weight: 500;
		font-size: 0.85em;
	}
</style>
