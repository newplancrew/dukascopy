---
const { size = 'medium', light = false } = Astro.props;

const sizes = {
  small: { gap: '10px', icon: '38px', name: '1.15rem' },
  medium: { gap: '12px', icon: '46px', name: '1.4rem' },
  large: { gap: '14px', icon: '54px', name: '1.75rem' },
};

const s = sizes[size];
const cls = light ? 'logo logo-light' : 'logo';
---

<a
	href="/"
	class={cls}
	aria-label="全球交易导航首页"
	style={`--logo-gap:${s.gap};--logo-icon:${s.icon};--logo-name:${s.name};`}
>
	<svg
		class="logo-icon"
		width="48"
		height="48"
		viewBox="0 0 48 48"
		fill="none"
		xmlns="http://www.w3.org/2000/svg"
		aria-hidden="true"
	>
		<rect x="2" y="2" width="44" height="44" rx="8" fill="#DA291C" />
		<rect x="19" y="8" width="10" height="32" rx="2" fill="#FFFFFF" />
		<rect x="8" y="19" width="32" height="10" rx="2" fill="#FFFFFF" />
		<text x="24" y="44" fill="#0A2540" font-family="Arial,Helvetica,sans-serif" font-size="14" font-weight="800" text-anchor="middle">₣</text>
	</svg>
	<span class="logo-text">
		<span class="logo-name">全球交易导航</span>
	</span>
</a>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: var(--logo-gap);
		text-decoration: none;
		white-space: nowrap;
	}

	.logo-icon {
		width: var(--logo-icon);
		height: auto;
		flex-shrink: 0;
	}

	.logo-text {
		display: flex;
		align-items: center;
	}

	.logo-name {
		font-size: var(--logo-name);
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--navy);
	}

	.logo-light .logo-name {
		color: var(--white);
	}

	@media (max-width: 480px) {
		.logo-icon {
			width: 34px;
		}
		.logo-name {
			font-size: 1rem;
		}
	}
</style>
