---
const { size = 'medium', light = false } = Astro.props;

const sizes = {
  small: { gap: '10px', icon: '38px', name: '1.15rem', sub: '0.65rem' },
  medium: { gap: '12px', icon: '46px', name: '1.4rem', sub: '0.75rem' },
  large: { gap: '14px', icon: '54px', name: '1.75rem', sub: '0.875rem' },
};

const s = sizes[size];
const cls = light ? 'logo logo-light' : 'logo';
---

<a
	href="/"
	class={cls}
	aria-label="全球交易导航首页"
	style={`--logo-gap:${s.gap};--logo-icon:${s.icon};--logo-name:${s.name};--logo-sub:${s.sub};`}
>
	<svg
		class="logo-icon"
		width="48"
		height="48"
		viewBox="0 0 48 48"
		fill="none"
		xmlns="http://www.w3.org/2000/svg"
		aria-hidden="true"
	>
		<rect width="48" height="48" rx="4" fill="#DA291C"/>
		<rect x="19" y="5" width="10" height="38" rx="1.5" fill="#FFFFFF"/>
		<rect x="5" y="19" width="38" height="10" rx="1.5" fill="#FFFFFF"/>
	</svg>
	<span class="logo-text">
		<span class="logo-name">全球交易导航</span>
		<span class="logo-sub">Dukascopy 推荐</span>
	</span>
</a>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: var(--logo-gap);
		text-decoration: none;
		white-space: nowrap;
	}

	.logo-icon {
		width: var(--logo-icon);
		height: auto;
		flex-shrink: 0;
	}

	.logo-text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		line-height: 1.15;
	}

	.logo-name {
		font-size: var(--logo-name);
		font-weight: 700;
		letter-spacing: 0.02em;
		color: var(--navy);
	}

	.logo-sub {
		font-size: var(--logo-sub);
		font-weight: 500;
		letter-spacing: 0.04em;
		color: var(--gray-400);
	}

	.logo-light .logo-name {
		color: var(--white);
	}

	.logo-light .logo-sub {
		color: var(--gray-300);
	}

	.logo-light .logo-icon rect:first-child {
		fill: var(--swiss-red);
	}

	@media (max-width: 480px) {
		.logo-icon {
			width: 34px;
		}
		.logo-name {
			font-size: 1rem;
		}
		.logo-sub {
			font-size: 0.6rem;
		}
	}
</style>
