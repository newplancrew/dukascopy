---
const { size = 'medium', light = false } = Astro.props;

const sizes = {
  small: { fontSize: '1.25rem', gap: '9px', icon: '38px' },
  medium: { fontSize: '1.5rem', gap: '11px', icon: '46px' },
  large: { fontSize: '2rem', gap: '14px', icon: '54px' },
};

const s = sizes[size];
const cls = light ? 'logo logo-light' : 'logo';
---

<a
	href="/"
	class={cls}
	aria-label="全球交易导航首页"
	style={`--logo-gap:${s.gap};--logo-size:${s.fontSize};--logo-icon:${s.icon};`}
>
	<svg
		class="logo-icon"
		width="48"
		height="48"
		viewBox="0 0 48 48"
		fill="none"
		xmlns="http://www.w3.org/2000/svg"
		aria-hidden="true"
	>
		<rect x="2" y="2" width="44" height="44" rx="8" fill="#DA291C"/>
		<rect x="20" y="8" width="8" height="32" fill="#FFFFFF" rx="1.5"/>
		<rect x="8" y="20" width="32" height="8" fill="#FFFFFF" rx="1.5"/>
		<text x="30.5" y="38" fill="#D4A843" font-family="Arial,Helvetica,sans-serif" font-size="16" font-weight="900">₣</text>
	</svg>
	<span class="logo-text">
		<span class="logo-name">全球交易导航</span>
	</span>
</a>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: var(--logo-gap);
		text-decoration: none;
		white-space: nowrap;
	}

	.logo-icon {
		width: var(--logo-icon);
		height: auto;
		flex-shrink: 0;
		filter: drop-shadow(0 1px 3px rgba(218, 41, 28, 0.18));
	}

	.logo-text {
		display: inline-flex;
		align-items: center;
		font-size: var(--logo-size);
		font-weight: 700;
		letter-spacing: 0.01em;
	}

	.logo-name {
		color: var(--navy);
	}

	.logo-light .logo-name {
		color: var(--white);
	}

	.logo-light .logo-icon rect:first-child {
		opacity: 0.92;
	}

	@media (max-width: 480px) {
		.logo-text {
			letter-spacing: 0;
		}
	}
</style>
