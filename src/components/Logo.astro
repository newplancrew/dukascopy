---
const { size = 20 } = Astro.props;
---

<span class="logo" aria-label="Dukascopy">
	<svg width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true">
		<path
			d="M12 2.25c4.9 0 8.9 4 8.9 8.9 0 4.9-4 8.9-8.9 8.9S3.1 16.05 3.1 11.15c0-4.9 4-8.9 8.9-8.9Z"
			stroke="rgba(255,255,255,.72)"
			stroke-width="1.2"
		/>
		<path
			d="M7.2 12.6c.9-2.9 2.6-5.4 4.8-6.8 2.4 1.4 4.1 3.9 4.8 6.8-1.1 2.3-2.8 4-4.8 5-2.2-1-3.8-2.7-4.8-5Z"
			fill="url(#g)"
			opacity="0.95"
		/>
		<defs>
			<linearGradient id="g" x1="6.5" y1="6" x2="18.2" y2="18.1" gradientUnits="userSpaceOnUse">
				<stop stop-color="#4cc9f0" />
				<stop offset="1" stop-color="#a1ffce" />
			</linearGradient>
		</defs>
	</svg>
	<span class="word">Dukascopy</span>
</span>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 10px;
	}

	.word {
		font-weight: 750;
		letter-spacing: -0.02em;
	}
</style>

