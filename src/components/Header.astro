---
import Logo from './Logo.astro';

const navLinks = [
	{ href: '/', label: '首页' },
	{ href: '/about', label: '关于我们' },
	{ href: '#trading', label: '交易产品' },
	{ href: '#platform', label: '交易平台' },
	{ href: '#accounts', label: '账户类型' },
];
---

<header class="header">
  <div class="container header-inner">
    <Logo />
    <nav class="nav">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </nav>
    <div class="header-actions">
			<a
				href="https://live-login.dukascopy.com/rto3/#!/?lang=zh"
				class="btn btn-outline btn-sm"
				target="_blank"
				rel="noreferrer"
				>登录</a
			>
			<a
				href="https://live-login.dukascopy.com/rto3/#!/?lang=zh"
				class="btn btn-primary btn-sm"
				target="_blank"
				rel="noreferrer"
				>开设账户</a
			>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--gray-100);
    height: var(--header-height);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--gray-600);
    transition: color 0.2s ease;
    position: relative;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--swiss-red);
    transition: width 0.2s ease;
    border-radius: 1px;
  }

  .nav-link:hover {
    color: var(--swiss-red);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .btn-sm {
    padding: 8px 20px;
    font-size: 0.875rem;
  }

  @media (max-width: 768px) {
    .nav {
      display: none;
    }
  }
</style>
