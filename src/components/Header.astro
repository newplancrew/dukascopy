---
import Logo from './Logo.astro';

const navLinks = [
	{ href: '/', label: '首页' },
	{ href: '/about', label: '关于本站' },
	{ href: '#trading', label: '交易产品' },
	{ href: '#platform', label: '交易平台' },
	{ href: '#accounts', label: '账户类型' },
];
---

<header class="header">
  <div class="container header-inner">
    <div class="header-brand">
      <Logo />
      <span class="badge">推荐平台</span>
    </div>
    <nav class="nav">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </nav>
    <div class="header-actions">
			<a
				href="https://live-login.dukascopy.com/rto3/#!/?lang=zh"
				class="btn btn-outline btn-sm"
				target="_blank"
				rel="noreferrer"
				>登录</a
			>
			<a
				href="https://live-login.dukascopy.com/rto3/#!/?lang=zh"
				class="btn btn-primary btn-sm"
				target="_blank"
				rel="noreferrer"
				>开设账户</a
			>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--gray-100);
    height: var(--header-height);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 12px;
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 10px;
    border-radius: 999px;
    background: rgba(218, 41, 28, 0.1);
    color: var(--swiss-red);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--gray-600);
    transition: color 0.2s ease;
    position: relative;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--swiss-red);
    transition: width 0.2s ease;
    border-radius: 1px;
  }

  .nav-link:hover {
    color: var(--swiss-red);
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .header-actions .btn {
    width: auto;
    white-space: nowrap;
  }

  .btn-sm {
    padding: 8px 20px;
    font-size: 0.875rem;
  }

  @media (max-width: 768px) {
    .nav {
      display: none;
    }
    .header-actions {
      gap: 8px;
    }
    .btn-sm {
      padding: 6px 14px;
      font-size: 0.8125rem;
    }
  }

  @media (max-width: 520px) {
    .badge {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .header-inner {
      gap: 10px;
    }

    .header-brand {
      gap: 8px;
    }

    .header-brand .logo {
      --logo-size: 1.125rem;
      --logo-gap: 7px;
      --logo-icon: 36px;
    }
  }
</style>
