---
const stats = [
	{ value: '20 年', label: '行业经验', note: '自 2006 年运营至今' },
	{ value: '1:200', label: '最高杠杆', note: '不同产品与地区可能不同' },
	{ value: '0.1 点起', label: '点差起始', note: '主要货币对' },
	{ value: '24', label: '货币支持', note: '多币种银行账户' },
];
---

<div class="card panel">
	<div class="grid grid-4">
		{stats.map((s) => (
			<div class="item">
				<div class="value">{s.value}</div>
				<div class="label">{s.label}</div>
				{s.note ? <div class="note">{s.note}</div> : null}
			</div>
		))}
	</div>
</div>

<style>
	.panel {
		padding: 20px;
		border-radius: var(--radius-xl);
		border: 1px solid var(--gray-100);
		background: linear-gradient(180deg, var(--white), var(--gray-50));
	}

	.item {
		padding: 14px 14px 12px;
		border-radius: var(--radius-lg);
		border: 1px solid var(--gray-100);
		background: var(--white);
	}

	.value {
		font-size: 1.75rem;
		font-weight: 750;
		letter-spacing: -0.02em;
		color: var(--swiss-red);
	}

	.label {
		margin-top: 6px;
		color: var(--gray-900);
		font-size: 0.9375rem;
		font-weight: 650;
	}

	.note {
		margin-top: 6px;
		color: var(--gray-500);
		font-size: 0.8125rem;
		line-height: 1.55;
	}
</style>
