---
const stats = [
	{ value: '20 年', label: '瑞士精准可靠交易', note: '基于官网首页公开介绍' },
	{ value: '1:200', label: '最高杠杆', note: '不同产品与监管地区可能不同' },
	{ value: '0.1 点起', label: '点差起始', note: '实际点差随市场变化' },
	{ value: '24', label: '多币种账户', note: '支持 IBAN 经常账户' },
];
---

<div class="card panel">
	<div class="grid grid-4">
		{stats.map((s) => (
			<div class="item">
				<div class="value">{s.value}</div>
				<div class="label">{s.label}</div>
				{s.note ? <div class="note">{s.note}</div> : null}
			</div>
		))}
	</div>
</div>

<style>
	.panel {
		padding: 20px;
		border-radius: var(--radius-xl);
		border: 1px solid var(--gray-100);
		background: linear-gradient(180deg, var(--white), var(--gray-50));
	}

	.item {
		padding: 14px 14px 12px;
		border-radius: var(--radius-lg);
		border: 1px solid var(--gray-100);
		background: var(--white);
	}

	.value {
		font-size: 1.75rem;
		font-weight: 750;
		letter-spacing: -0.02em;
		color: var(--swiss-red);
	}

	.label {
		margin-top: 6px;
		color: var(--gray-900);
		font-size: 0.9375rem;
		font-weight: 650;
	}

	.note {
		margin-top: 6px;
		color: var(--gray-500);
		font-size: 0.8125rem;
		line-height: 1.55;
	}
</style>
