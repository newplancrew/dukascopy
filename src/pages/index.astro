---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Stats from '../components/Stats.astro';
import CTA from '../components/CTA.astro';

const title = '全球交易导航 — 杜高斯贝银行评测与开户指南';
const description = '独立评测杜高斯贝银行：瑞士金融监管，外汇/CFD/加密货币/贵金属交易，多币种银行账户。完整开户流程引导与交易平台对比。';
---
<BaseLayout title={title} description={description}>
	<Header />

	<main>
		<section class="hero">
			<div class="container">
				<div class="hero-grid">
					<div>
						<div class="kicker">独立评测 · 开户引导</div>
						<h1 class="h1">杜高斯贝银行深度评测</h1>
						<p class="hero-subtitle">
							瑞士 FINMA 监管 · 20 年行业经验 · 多资产交易与银行服务一体化
						</p>
						<div class="hero-review">
							<div class="review-score">
								<span class="score">8.9</span>
								<div class="score-meta">
									<div class="stars">★★★★★</div>
									<span class="score-label">综合评分</span>
								</div>
							</div>
							<div class="review-tags">
								<span class="tag">FINMA 监管</span>
								<span class="tag">瑞士银行</span>
								<span class="tag">多币种账户</span>
								<span class="tag">杠杆 1:200</span>
							</div>
						</div>
						<div class="hero-actions">
							<a
								class="btn btn-primary"
								href="https://live-login.dukascopy.com/rto3/#!/?lang=zh"
								target="_blank"
								rel="noreferrer"
								>前往官网开设账户 →</a
							>
							<a
								class="btn btn-outline"
								href="https://www.dukascopy.com/swiss/chinese/forex/demo-fx-account/?headerBar=main-slider"
								target="_blank"
								rel="noreferrer"
								>试用模拟账户</a
							>
						</div>
						<div class="hero-disclosure">
							本站为独立推荐平台。通过本站链接开户，我们可能获得推荐佣金。
						</div>
					</div>
					<div class="hero-card">
						<div class="hero-card-top">
							<div class="hero-card-kicker">快速导航</div>
							<div class="hero-card-title">开户只需三步</div>
						</div>
						<div class="steps">
							<div class="step">
								<span class="step-num">1</span>
								<div>
									<div class="step-title">填写申请表</div>
									<div class="step-desc">选择账户类型，提交基本信息</div>
								</div>
							</div>
							<div class="step">
								<span class="step-num">2</span>
								<div>
									<div class="step-title">身份验证</div>
									<div class="step-desc">提交身份证件与居住证明</div>
								</div>
							</div>
							<div class="step">
								<span class="step-num">3</span>
								<div>
									<div class="step-title">入金并开始交易</div>
									<div class="step-desc">充值后即可在全球市场交易</div>
								</div>
							</div>
						</div>
						<div class="hero-card-foot">
							<a class="small-link" href="https://live-login.dukascopy.com/rto3/#!/?lang=zh" target="_blank" rel="noreferrer">立即开户 →</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="section sm surface">
			<div class="container">
				<Stats />
			</div>
		</section>

		<section id="trading" class="section">
			<div class="container">
				<div class="section-header">
					<div class="kicker">交易产品一览</div>
					<h2 class="h2">杜高斯贝支持哪些交易产品</h2>
					<p class="lead">
						通过杜高斯贝银行，您可以交易外汇、差价合约、加密货币、贵金属等全球主要金融产品。以下为核心产品介绍与开户引导。
					</p>
				</div>
				<FeatureGrid />
			</div>
		</section>

		<section id="platform" class="section surface">
			<div class="container">
				<div class="section-header">
					<div class="kicker">交易平台对比</div>
					<h2 class="h2">三款主流交易平台，满足不同需求</h2>
					<p class="lead">根据您的交易习惯选择最适合的平台。以下为各平台特点对比。</p>
				</div>
				<div class="grid grid-3">
					<div class="card platform-card">
						<div class="platform-top">
							<div class="platform-k">JForex (DealStation)</div>
							<div class="platform-t">专业自动化交易</div>
						</div>
						<p class="muted">
							杜高斯贝自主研发的交易平台，支持高级订单类型、策略回测与自动交易。适合需要算法交易功能的专业交易者。
						</p>
						<a class="btn btn-outline" href="https://www.dukascopy.com/swiss/chinese/forex/dealstation/" target="_blank" rel="noreferrer" style="margin-top:16px">了解详情 →</a>
					</div>
					<div class="card platform-card">
						<div class="platform-top">
							<div class="platform-k">MetaTrader 4</div>
							<div class="platform-t">经典交易生态</div>
						</div>
						<p class="muted">
							全球最受欢迎的交易平台之一，支持 EA 自动交易、丰富的技术指标和分析工具。适合 MT4 生态用户。
						</p>
						<a class="btn btn-outline" href="https://www.dukascopy.com/swiss/chinese/forex/mt4-accounts/" target="_blank" rel="noreferrer" style="margin-top:16px">了解详情 →</a>
					</div>
					<div class="card platform-card">
						<div class="platform-top">
							<div class="platform-k">MetaTrader 5</div>
							<div class="platform-t">多资产扩展</div>
						</div>
						<p class="muted">
							支持更多交易品种和时间框架，提供更强大的分析工具。适合需要多资产交易和高级分析的用户。
						</p>
						<a class="btn btn-outline" href="https://www.dukascopy.com/swiss/chinese/forex/mt5-accounts/" target="_blank" rel="noreferrer" style="margin-top:16px">了解详情 →</a>
					</div>
				</div>
			</div>
		</section>

		<section id="accounts" class="section">
			<div class="container">
				<div class="section-header">
					<div class="kicker">银行服务</div>
					<h2 class="h2">不止是交易平台</h2>
					<p class="lead">杜高斯贝同时提供瑞士银行服务，包括多币种账户、实体卡与虚拟卡、财富管理等。</p>
				</div>
				<div class="grid grid-2">
					<div class="card account-card">
						<div class="account-kicker">多币种经常账户</div>
						<h3 class="account-title">支持 24 种货币 · 附带 IBAN</h3>
						<p class="muted">
							一个账户管理多种货币资金，支持远程在线开户。适合跨币种资产管理与全球资金收付。
						</p>
						<a
							class="btn btn-outline"
							href="https://www.dukascopy.bank/swiss/open-mca-account/?lang=zh"
							target="_blank"
							rel="noreferrer"
							>了解账户详情 →</a
						>
					</div>
					<div class="card account-card">
						<div class="account-kicker">实体卡与虚拟卡</div>
						<h3 class="account-title">灵活的资金管理工具</h3>
						<p class="muted">
							可通过卡片进行账户注资与日常消费，支持信用卡和借记卡充值。为交易资金提供便捷的出入金通道。
						</p>
						<a
							class="btn btn-outline"
							href="https://www.dukascopy.bank/swiss/fees-limits/?lang=zh#dukascopy-card"
							target="_blank"
							rel="noreferrer"
							>查看卡片详情 →</a
						>
					</div>
				</div>
			</div>
		</section>

		<CTA />
	</main>

	<Footer />
</BaseLayout>

<style>
	.hero {
		padding: 80px 0 60px;
		background: linear-gradient(180deg, var(--white), var(--gray-50));
		border-bottom: 1px solid var(--gray-100);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: 40px;
		align-items: start;
	}

	.hero-subtitle {
		margin-top: 12px;
		font-size: 1.125rem;
		color: var(--gray-500);
		line-height: 1.6;
	}

	.hero-review {
		margin-top: 24px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.review-score {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.score {
		font-size: 3rem;
		font-weight: 800;
		color: var(--navy);
		line-height: 1;
	}

	.score-meta {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.stars {
		color: var(--accent-gold);
		font-size: 1.125rem;
		letter-spacing: 2px;
	}

	.score-label {
		font-size: 0.8125rem;
		color: var(--gray-500);
	}

	.review-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.tag {
		display: inline-flex;
		padding: 4px 12px;
		border-radius: 999px;
		background: var(--gray-50);
		border: 1px solid var(--gray-200);
		color: var(--gray-600);
		font-size: 0.8125rem;
		font-weight: 500;
	}

	.hero-actions {
		display: flex;
		gap: 12px;
		margin-top: 28px;
		flex-wrap: wrap;
	}

	.hero-disclosure {
		margin-top: 16px;
		font-size: 0.8125rem;
		color: var(--gray-400);
		padding: 12px 16px;
		border-radius: var(--radius-md);
		background: var(--gray-50);
		border: 1px solid var(--gray-100);
	}

	.hero-card {
		border-radius: var(--radius-xl);
		border: 1px solid var(--gray-100);
		background: var(--white);
		box-shadow: 0 18px 60px rgba(0, 0, 0, 0.06);
		overflow: hidden;
	}

	.hero-card-top {
		padding: 20px 20px 16px;
		border-bottom: 1px solid var(--gray-100);
	}

	.hero-card-kicker {
		color: var(--swiss-red);
		font-size: 0.8125rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.hero-card-title {
		margin-top: 6px;
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--navy);
	}

	.steps {
		padding: 16px 20px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.step {
		display: flex;
		gap: 14px;
		align-items: flex-start;
	}

	.step-num {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 999px;
		background: var(--swiss-red);
		color: var(--white);
		font-size: 0.875rem;
		font-weight: 700;
		flex-shrink: 0;
	}

	.step-title {
		font-weight: 600;
		color: var(--gray-900);
		font-size: 0.9375rem;
	}

	.step-desc {
		margin-top: 2px;
		color: var(--gray-500);
		font-size: 0.8125rem;
	}

	.hero-card-foot {
		padding: 12px 20px 20px;
		border-top: 1px solid var(--gray-100);
	}

	.small-link {
		color: var(--swiss-red);
		font-weight: 600;
		font-size: 0.9375rem;
	}

	.small-link:hover {
		text-decoration: underline;
	}

	.section-header {
		margin-bottom: 40px;
	}

	.section-header .kicker {
		margin-bottom: 10px;
	}

	.section-header .lead {
		margin-top: 12px;
	}

	.platform-card p {
		margin-top: 12px;
		line-height: 1.75;
	}

	.platform-top {
		display: grid;
		gap: 4px;
	}

	.platform-k {
		color: var(--swiss-red);
		font-weight: 700;
		font-size: 0.875rem;
	}

	.platform-t {
		font-size: 1.125rem;
		font-weight: 700;
		color: var(--navy);
	}

	.account-card .btn {
		margin-top: 16px;
	}

	.account-kicker {
		color: var(--swiss-red);
		font-weight: 600;
		font-size: 0.875rem;
		margin-bottom: 8px;
	}

	.account-title {
		font-size: 1.25rem;
		color: var(--navy);
	}

	.account-card p {
		margin-top: 10px;
		line-height: 1.75;
	}

	@media (max-width: 980px) {
		.hero-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
